<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:controls="clr-namespace:CxShell.Controls"
             xmlns:vm="clr-namespace:CxShell.ViewModels"
             x:Class="CxShell.Views.RdpView"
             x:DataType="vm:RdpViewModel"
             Focusable="True"
             Cursor="Arrow"
             Background="{atom:SharedTokenResource ColorBgLayout}">
    <Grid>
        <Border x:Name="RdpViewport"
                Background="#111111"
                Cursor="Arrow"
                ClipToBounds="True"
                DragDrop.AllowDrop="True"
                SizeChanged="OnViewportSizeChanged">
            <Grid>
                <Image x:Name="FramebufferImage"
                       Source="{Binding Framebuffer}"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Cursor="Arrow"
                       Focusable="True"
                       PointerMoved="OnFramebufferPointerMoved"
                       PointerPressed="OnFramebufferPointerPressed"
                       PointerReleased="OnFramebufferPointerReleased"
                       PointerWheelChanged="OnFramebufferPointerWheelChanged"/>
                <controls:RdpSliceSurface x:Name="PrimarySliceSurface"
                                          IsVisible="False"
                                          Focusable="True"
                                          PointerMoved="OnFramebufferPointerMoved"
                                          PointerPressed="OnFramebufferPointerPressed"
                                          PointerReleased="OnFramebufferPointerReleased"
                                          PointerWheelChanged="OnFramebufferPointerWheelChanged"/>
            </Grid>
        </Border>

        <!-- Primary screen top-edge hover trigger for multi-monitor floating bar -->
        <Border Height="6"
                VerticalAlignment="Top"
                Background="Transparent"
                PointerEntered="OnPrimaryTopHotZoneEntered"/>

        <Border x:Name="PrimaryFloatingBar"
                IsVisible="False"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,6,0,0"
                Padding="10,5"
                CornerRadius="8"
                Background="#E61E1E1E"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                PointerExited="OnPrimaryFloatingBarExited">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="MultiMonitorButton"
                        Content="多显示器"
                        FontSize="11"
                        Padding="8,3"
                        Click="OnMultiMonitorButtonClick"/>
                <Popup x:Name="MultiMonitorPopup"
                       PlacementTarget="{Binding #MultiMonitorButton}"
                       Placement="Bottom"
                       IsLightDismissEnabled="True">
                    <Border Padding="12,10"
                            CornerRadius="8"
                            Background="#F2242424"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            MinWidth="240">
                        <StackPanel Spacing="6">
                            <TextBlock Text="选择要启用的显示器（实时热切换）"
                                       Foreground="#E0E0E0"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <StackPanel x:Name="MonitorCheckboxList" Spacing="4"/>
                            <Border Height="1" Background="#30FFFFFF" Margin="0,4"/>
                            <TextBlock Text="带鱼屏 / 虚拟分屏模式"
                                       Foreground="#C0C0C0"
                                       FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="ModeStandardButton"
                                        Content="标准"
                                        FontSize="11"
                                        Padding="8,3"
                                        Click="OnUltrawideModeStandardClick"/>
                                <Button x:Name="ModeSplitDualButton"
                                        Content="单屏→远端双屏"
                                        FontSize="11"
                                        Padding="8,3"
                                        Click="OnUltrawideModeSplitDualClick"/>
                                <Button x:Name="ModeMergeUltrawideButton"
                                        Content="双屏→远端带鱼屏"
                                        FontSize="11"
                                        Padding="8,3"
                                        Click="OnUltrawideModeMergeUltrawideClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
